Procedure ShowHelp;
Begin
  Writeln('TESSERACT - Cette commande permet de lancer la reconnaissance de caracteres d''une image.');
  Writeln;
  Writeln('Description :');
  Writeln('  Lit le texte d''une image PBM, PNG, JPEG, GIF ou BMP (decodeurs integres, format');
  Writeln('  detecte par le contenu du fichier) et l''ecrit dans un fichier texte UTF-8,');
  Writeln('  en conservant les lignes, l''indentation et les lignes vides. La police');
  Writeln('  (Segoe UI, Arial ou Consolas) et sa taille sont detectees automatiquement;');
  Writeln('  texte clair sur fond sombre ou sombre sur fond clair, lettres, chiffres,');
  Writeln('  symboles et lettres accentuees.');
  Writeln;
  Writeln('Syntaxe :');
  Writeln('  TESSERACT image base_de_sortie [-l langue] [-f police] [-s taille]');
  Writeln('  TESSERACT /?');
  Writeln;
  Writeln('Parametres :');
  Writeln('  image            Fichier image d''entree (maximum 32000 x 16000 pixels) :');
  Writeln('                   PBM ASCII P1, PNG (toutes profondeurs, entrelace ou non),');
  Writeln('                   JPEG de base (non progressif), GIF (premiere image) et');
  Writeln('                   BMP (1 a 32 bits, RLE4 et RLE8 inclus).');
  Writeln('  base_de_sortie   Nom de base du fichier de sortie; l''extension .txt');
  Writeln('                   est ajoutee automatiquement.');
  Writeln('  -l langue        Langue : eng (anglais), fra (francais, par defaut), deu');
  Writeln('                   (allemand), spa (espagnol), por (portugais), swe (suedois),');
  Writeln('                   ita (italien), sqi (albanais), dan (danois), jpn (japonais');
  Writeln('                   ecrit en romaji, avec macrons). On peut');
  Writeln('                   combiner avec + (ex. fra+eng). La langue determine les');
  Writeln('                   lettres accentuees reconnues.');
  Writeln('  -f police        auto (par defaut), segoe, arial, consolas ou 5x7');
  Writeln('                   (ancienne police matricielle 5 x 7, A-Z et 0-9 seulement).');
  Writeln('  -s taille        Taille de la police en pixels d''em (6 a 48), ex. 13.33 pour');
  Writeln('                   10 pt a 96 ppp. Detectee automatiquement si omise.');
  Writeln('  /?               Affiche cette aide (aussi -?, -h et --help).');
  Writeln;
  Writeln('Exemple :');
  Writeln('  TESSERACT capture.png sortie -l fra');
  Writeln('  TESSERACT code.png sortie -f consolas -s 14');
  Writeln('  TESSERACT brief.png sortie -l deu');
End;

Function GetInk(PixelX, PixelY: Integer): Boolean;
Begin
  GetInk := Image^[PixelY]^[PixelX] >= 8;
End;

Function RowHasInk(RowNumber: Integer): Boolean;
Var
  Column: Integer;
Begin
  RowHasInk := False;
  For Column := 1 To ImageWidth Do
    If GetInk(Column, RowNumber) Then
    Begin
      RowHasInk := True;
      Exit;
    End;
End;

Function ColumnHasInk(ColumnNumber, FirstRow, LastRow: Integer): Boolean;
Var
  Row: Integer;
Begin
  ColumnHasInk := False;
  For Row := FirstRow To LastRow Do
    If GetInk(ColumnNumber, Row) Then
    Begin
      ColumnHasInk := True;
      Exit;
    End;
End;

Function RecognizeGlyph(FirstColumn, LastColumn, FirstRow, LastRow: Integer): Char;
Begin
  BestErrors := 36;
  BestIndex := 0;
  For FontIndex := 1 To 36 Do
  Begin
    Errors := 0;
    For RowIndex := 1 To 7 Do
    Begin
      SourceY := FirstRow + (Longint(2 * RowIndex - 1) * (LastRow - FirstRow + 1)) Div 14;
      For ColumnIndex := 1 To 5 Do
      Begin
        SourceX := FirstColumn + (Longint(2 * ColumnIndex - 1) * (LastColumn - FirstColumn + 1)) Div 10;
        If GetInk(SourceX, SourceY) <>
           (Font[FontIndex][(RowIndex - 1) * 5 + ColumnIndex] = '1') Then
          Inc(Errors);
      End;
    End;
    If Errors < BestErrors Then
    Begin
      BestErrors := Errors;
      BestIndex := FontIndex;
    End;
  End;

  If (BestIndex = 0) Or (BestErrors > 17) Then
    RecognizeGlyph := '?'
  Else
    RecognizeGlyph := FontCharacters[BestIndex];
End;

