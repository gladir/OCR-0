Procedure ShowHelp;
Begin
  Writeln('TESSERACT - Cette commande permet de lancer la reconnaissance de caracteres d''une image.');
  Writeln;
  Writeln('Description :');
  Writeln('  Lit le texte d''une image PBM, PNG, JPEG ou GIF (decodeurs integres, format');
  Writeln('  detecte par le contenu du fichier) et l''ecrit dans un fichier texte UTF-8,');
  Writeln('  en conservant les lignes, l''indentation et les lignes vides. Convient au');
  Writeln('  code source et au texte en police Segoe UI 10 pt (13,33 pixels), clair sur');
  Writeln('  fond sombre ou sombre sur fond clair, avec lettres accentuees francaises.');
  Writeln;
  Writeln('Syntaxe :');
  Writeln('  TESSERACT image base_de_sortie [-l fra] [-f segoe|5x7]');
  Writeln('  TESSERACT /?');
  Writeln;
  Writeln('Parametres :');
  Writeln('  image            Fichier image d''entree (maximum 32000 x 16000 pixels) :');
  Writeln('                   PBM ASCII P1, PNG (toutes profondeurs, entrelace ou non),');
  Writeln('                   JPEG de base (non progressif) et GIF (premiere image).');
  Writeln('  base_de_sortie   Nom de base du fichier de sortie; l''extension .txt');
  Writeln('                   est ajoutee automatiquement.');
  Writeln('  -l fra           Langue de reconnaissance (seule la valeur fra est acceptee).');
  Writeln('  -f segoe         Police Segoe UI 10 pt, lettres, chiffres, symboles et');
  Writeln('                   accents (par defaut). Largeur maximale : 16000 pixels.');
  Writeln('  -f 5x7           Ancienne police matricielle 5 x 7 (A-Z et 0-9 seulement).');
  Writeln('  /?               Affiche cette aide (aussi -?, -h et --help).');
  Writeln;
  Writeln('Exemple :');
  Writeln('  TESSERACT capture.png sortie -l fra');
End;

Function GetInk(PixelX, PixelY: Integer): Boolean;
Begin
  GetInk := Image^[PixelY]^[PixelX] >= 8;
End;

